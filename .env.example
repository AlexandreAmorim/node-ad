NODE_ENV=development
PORT=3000

# Active Directory Configuration
AD_URL=ldaps://your-dc.domain.com:636
AD_BASE_DN=DC=domain,DC=com
AD_USERNAME=admin@domain.com
AD_PASSWORD=your_admin_password

SIPOL_USER=
SIPOL_PASSWORD=
SIPOL_URL=https://sipol.pcivil.rj.gov.br/informacoes-compartilhadas-api

DETRAN_URL_SET=http://10.200.96.170:8080
DETRAN_URL_GET=http://10.200.96.170:8181
DETRAN_CNPJ=
DETRAN_KEY=
DETRAN_PROFILE=

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here

# TLS Configuration (set to false for self-signed certificates in dev)
AD_TLS_REJECT_UNAUTHORIZED=true
TSC_COMPILE_ON_ERROR=true

# Formato do manual: http://[servidor php]/sei/controlador_ws.php?servico=sei
SEI_WSDL_URL=https://sei.rj.gov.br/sei/controlador_ws.php?servico=sei

# Sigla do sistema cadastrado no SEI (Administração > Sistemas > campo "Sigla")
SEI_SIGLA_SISTEMA=ACOMPANHAMENTO

# Chave de acesso gerada no SEI (Serviços > Gerar Chave de Acesso).
# Vai no parâmetro IdentificacaoServico de TODAS as chamadas.
# A chave só é exibida uma vez, no momento da geração.
SEI_CHAVE_ACESSO=troque-pela-chave-real

# Id da unidade liberada no cadastro do serviço (numérico, ex.: 100000885)
SEI_ID_UNIDADE=000000000

# Encoding do SoapClient. O manual usa ISO-8859-1; instalações mais novas
# do SEI costumam aceitar UTF-8. Confirme com o gestor.
SEI_ENCODING=ISO-8859-1

# Timeout por chamada SOAP (ms)
SEI_TIMEOUT_MS=30000

# Ids de tarefa usados no filtro do listarAndamentos.
# ATENÇÃO: o manual exige pelo menos um de Andamentos/Tarefas/TarefasModulos.
# Os valores reais estão nas constantes de TarefaRN.php da instalação.
# Peça a lista ao gestor do SEI antes de habilitar o histórico completo.
SEI_TAREFAS_ANDAMENTO=

# Usa o client mock (fixtures locais) em vez do SOAP real.
# Deixe true enquanto a chave de acesso não sair.
SEI_MOCK=true

# ---------------------------------------------------------------------------
# Worker de polling
# ---------------------------------------------------------------------------
# Intervalo entre ciclos do worker (ms)
WORKER_TICK_MS=60000
# Quantos processos são sincronizados em paralelo
WORKER_CONCURRENCY=3
# Quantos processos são puxados por ciclo
WORKER_BATCH_SIZE=50

DATABASE_URL=