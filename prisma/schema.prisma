generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Setting {
  id           Int       @id @default(autoincrement())
  sipol_status Boolean?  @default(true)
  sipol_token  String?
  segov_status Boolean?  @default(true)
  segov_token  String?
  created_at   DateTime? @default(now())
  updated_at   DateTime? @default(now())

  @@map("settings")
}

// -----------------------------------------------------------------------------
// Processos em acompanhamento
// -----------------------------------------------------------------------------

model Processo {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  protocolo        String  @unique
  protocoloDigitos String  @map("protocolo_digitos")
  idProcedimento   String? @map("id_procedimento")

  tipoProcedimentoId   String?   @map("tipo_procedimento_id")
  tipoProcedimentoNome String?   @map("tipo_procedimento_nome")
  especificacao        String?
  dataAutuacao         DateTime? @map("data_autuacao") @db.Date
  nivelAcessoGlobal    Int?      @map("nivel_acesso_global") @db.SmallInt
  linkAcesso           String?   @map("link_acesso")

  concluido            Boolean   @default(false)
  unidadesAbertas      Json      @default("[]") @map("unidades_abertas") @db.JsonB
  ultimoAndamentoId    String?   @map("ultimo_andamento_id")
  ultimoAndamentoEm    DateTime? @map("ultimo_andamento_em") @db.Timestamptz(6)
  ultimoAndamentoTexto String?   @map("ultimo_andamento_texto")

  ativo             Boolean @default(true)
  rotulo            String?
  observacaoInterna String? @map("observacao_interna")

  sincronizadoEm       DateTime? @map("sincronizado_em") @db.Timestamptz(6)
  proximaSincronizacao DateTime  @default(now()) @map("proxima_sincronizacao") @db.Timestamptz(6)
  falhasConsecutivas   Int       @default(0) @map("falhas_consecutivas")
  ultimoErro           String?   @map("ultimo_erro")
  ultimoErroTipo       String?   @map("ultimo_erro_tipo")

  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  andamentos Andamento[]
  eventos    Evento[]
  syncLogs   SyncLog[]

  @@index([protocoloDigitos], map: "processo_digitos_idx")
  // Índice parcial da fila (WHERE ativo AND NOT concluido) precisa ir na migration SQL —
  // o Prisma não expressa predicado WHERE em @@index.
  @@index([proximaSincronizacao], map: "processo_fila_idx")
  @@map("processo")
}

// -----------------------------------------------------------------------------
// Histórico de andamentos
// -----------------------------------------------------------------------------

model Andamento {
  id BigInt @id @default(autoincrement())

  processoId String   @map("processo_id") @db.Uuid
  processo   Processo @relation(fields: [processoId], references: [id], onDelete: Cascade)

  idAndamento String   @map("id_andamento")
  idTarefa    String?  @map("id_tarefa")
  descricao   String
  ocorridoEm  DateTime @map("ocorrido_em") @db.Timestamptz(6)

  unidadeId    String? @map("unidade_id")
  unidadeSigla String? @map("unidade_sigla")
  unidadeNome  String? @map("unidade_nome")
  usuarioSigla String? @map("usuario_sigla")
  usuarioNome  String? @map("usuario_nome")
  atributos    Json    @default("{}") @db.JsonB

  registradoEm DateTime @default(now()) @map("registrado_em") @db.Timestamptz(6)

  @@unique([processoId, idAndamento], map: "andamento_unico")
  @@index([processoId, ocorridoEm(sort: Desc)], map: "andamento_timeline_idx")
  @@map("andamento")
}

// -----------------------------------------------------------------------------
// Eventos gerados pelo diff
// -----------------------------------------------------------------------------

enum EventoTipo {
  novo_andamento
  mudou_unidade
  concluido
  reaberto
  erro_sincronizacao

  @@map("evento_tipo")
}

model Evento {
  id BigInt @id @default(autoincrement())

  processoId String   @map("processo_id") @db.Uuid
  processo   Processo @relation(fields: [processoId], references: [id], onDelete: Cascade)

  tipo         EventoTipo
  payload      Json       @default("{}") @db.JsonB
  criadoEm     DateTime   @default(now()) @map("criado_em") @db.Timestamptz(6)
  processadoEm DateTime?  @map("processado_em") @db.Timestamptz(6)

  // Índice parcial (WHERE processado_em IS NULL) também fica na migration SQL.
  @@index([criadoEm], map: "evento_pendente_idx")
  @@map("evento")
}

// -----------------------------------------------------------------------------
// Log de sincronização
// -----------------------------------------------------------------------------

model SyncLog {
  id BigInt @id @default(autoincrement())

  processoId String?   @map("processo_id") @db.Uuid
  processo   Processo? @relation(fields: [processoId], references: [id], onDelete: SetNull)

  iniciadoEm      DateTime @default(now()) @map("iniciado_em") @db.Timestamptz(6)
  duracaoMs       Int?     @map("duracao_ms")
  sucesso         Boolean
  andamentosNovos Int      @default(0) @map("andamentos_novos")
  erro            String?
  erroTipo        String?  @map("erro_tipo")

  @@index([processoId, iniciadoEm(sort: Desc)], map: "sync_log_processo_idx")
  @@map("sync_log")
}

// -----------------------------------------------------------------------------
// Cache de tabelas auxiliares do SEI
// -----------------------------------------------------------------------------

model SeiUnidade {
  idUnidade    String   @id @map("id_unidade")
  sigla        String
  descricao    String?
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  @@map("sei_unidade")
}

model SeiTipoProcedimento {
  idTipoProcedimento String   @id @map("id_tipo_procedimento")
  nome               String
  atualizadoEm       DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  @@map("sei_tipo_procedimento")
}

// -----------------------------------------------------------------------------
// Mapeamento OU do AD ↔ unidade SEI (seção)
// -----------------------------------------------------------------------------

model SecaoAdMap {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ouCodigo     String   @unique @map("ou_codigo")
  nome         String
  seiIdUnidade String?  @map("sei_id_unidade")
  seiSigla     String?  @map("sei_sigla")
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  chamados Chamado[]

  @@map("secao_ad_map")
}

// -----------------------------------------------------------------------------
// Helpdesk — chamados
// -----------------------------------------------------------------------------

enum ChamadoStatus {
  novo
  em_atendimento
  aguardando_solicitante
  resolvido
  fechado
  cancelado

  @@map("chamado_status")
}

enum ChamadoPrioridade {
  baixa
  media
  alta
  urgente

  @@map("chamado_prioridade")
}

model Categoria {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome      String
  descricao String?
  parentId  String?     @map("parent_id") @db.Uuid
  parent    Categoria?  @relation("CategoriaArvore", fields: [parentId], references: [id])
  filhos    Categoria[] @relation("CategoriaArvore")
  ativo     Boolean     @default(true)
  criadoEm  DateTime    @default(now()) @map("criado_em") @db.Timestamptz(6)

  chamados Chamado[]

  @@map("categoria")
}

model Chamado {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  numero Int    @unique @default(autoincrement())

  titulo     String
  descricao  String
  status     ChamadoStatus     @default(novo)
  prioridade ChamadoPrioridade @default(media)

  solicitanteUsername String  @map("solicitante_username")
  solicitanteNome     String? @map("solicitante_nome")
  atendenteUsername   String? @map("atendente_username")
  atendenteNome       String? @map("atendente_nome")

  secaoId  String?     @map("secao_id") @db.Uuid
  secao    SecaoAdMap? @relation(fields: [secaoId], references: [id])
  ouCodigo String?     @map("ou_codigo")

  categoriaId String?    @map("categoria_id") @db.Uuid
  categoria   Categoria? @relation(fields: [categoriaId], references: [id])

  prazoRespostaEm DateTime? @map("prazo_resposta_em") @db.Timestamptz(6)
  prazoSolucaoEm  DateTime? @map("prazo_solucao_em") @db.Timestamptz(6)
  resolvidoEm     DateTime? @map("resolvido_em") @db.Timestamptz(6)
  fechadoEm       DateTime? @map("fechado_em") @db.Timestamptz(6)

  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  comentarios ChamadoComentario[]
  historico   ChamadoHistorico[]
  ativos      ChamadoAtivo[]

  @@index([solicitanteUsername], map: "chamado_solicitante_idx")
  @@index([atendenteUsername], map: "chamado_atendente_idx")
  @@index([status], map: "chamado_status_idx")
  @@index([ouCodigo], map: "chamado_ou_idx")
  @@map("chamado")
}

model ChamadoComentario {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chamadoId String  @map("chamado_id") @db.Uuid
  chamado   Chamado @relation(fields: [chamadoId], references: [id], onDelete: Cascade)

  autorUsername String  @map("autor_username")
  autorNome     String? @map("autor_nome")
  texto         String
  interno       Boolean @default(false)

  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@index([chamadoId, criadoEm], map: "chamado_comentario_idx")
  @@map("chamado_comentario")
}

model ChamadoHistorico {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chamadoId String  @map("chamado_id") @db.Uuid
  chamado   Chamado @relation(fields: [chamadoId], references: [id], onDelete: Cascade)

  autorUsername String  @map("autor_username")
  campo         String
  valorAnterior String? @map("valor_anterior")
  valorNovo     String? @map("valor_novo")

  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@index([chamadoId, criadoEm], map: "chamado_historico_idx")
  @@map("chamado_historico")
}

// -----------------------------------------------------------------------------
// CMDB / Inventário de ativos (estilo GLPI)
// -----------------------------------------------------------------------------

enum AtivoTipo {
  computador
  monitor
  impressora
  rede
  telefone
  periferico
  software
  outro

  @@map("ativo_tipo")
}

enum AtivoStatus {
  em_estoque
  em_uso
  em_manutencao
  reservado
  descartado

  @@map("ativo_status")
}

model Fabricante {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome     String   @unique
  site     String?
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  modelos ModeloAtivo[]
  ativos  Ativo[]

  @@map("fabricante")
}

model ModeloAtivo {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome         String
  tipo         AtivoTipo   @default(computador)
  fabricanteId String?     @map("fabricante_id") @db.Uuid
  fabricante   Fabricante? @relation(fields: [fabricanteId], references: [id])
  ativo        Boolean     @default(true)
  criadoEm     DateTime    @default(now()) @map("criado_em") @db.Timestamptz(6)

  ativos Ativo[]

  @@unique([fabricanteId, nome, tipo])
  @@map("modelo_ativo")
}

model Localizacao {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome       String
  codigo     String?       @unique
  parentId   String?       @map("parent_id") @db.Uuid
  parent     Localizacao?  @relation("LocalArvore", fields: [parentId], references: [id])
  filhos     Localizacao[] @relation("LocalArvore")
  endereco   String?
  ativo      Boolean       @default(true)
  criadoEm   DateTime      @default(now()) @map("criado_em") @db.Timestamptz(6)

  ativos Ativo[]

  @@map("localizacao")
}

model Fornecedor {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome     String   @unique
  cnpj     String?
  contato  String?
  email    String?
  telefone String?
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  ativos Ativo[]

  @@map("fornecedor")
}

model Ativo {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  numero Int    @unique @default(autoincrement())

  nome            String
  tipo            AtivoTipo   @default(computador)
  status          AtivoStatus @default(em_estoque)
  numeroSerie     String?     @map("numero_serie")
  numeroPatrimonio String?    @unique @map("numero_patrimonio")
  numeroInventario String?    @map("numero_inventario")

  fabricanteId String?     @map("fabricante_id") @db.Uuid
  fabricante   Fabricante? @relation(fields: [fabricanteId], references: [id])
  modeloId     String?     @map("modelo_id") @db.Uuid
  modelo       ModeloAtivo? @relation(fields: [modeloId], references: [id])
  localizacaoId String?    @map("localizacao_id") @db.Uuid
  localizacao  Localizacao? @relation(fields: [localizacaoId], references: [id])
  fornecedorId String?     @map("fornecedor_id") @db.Uuid
  fornecedor   Fornecedor? @relation(fields: [fornecedorId], references: [id])

  /** Usuário AD responsável / em uso */
  usuarioUsername String? @map("usuario_username")
  usuarioNome     String? @map("usuario_nome")
  ouCodigo        String? @map("ou_codigo")

  dataAquisicao DateTime? @map("data_aquisicao") @db.Date
  dataGarantia  DateTime? @map("data_garantia") @db.Date
  valor         Decimal?  @db.Decimal(12, 2)
  observacao    String?

  /** Campos técnicos opcionais (CPU, RAM, IP, MAC…) */
  specs Json @default("{}") @db.JsonB

  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  historico AtivoHistorico[]
  chamados  ChamadoAtivo[]

  @@index([tipo], map: "ativo_tipo_idx")
  @@index([status], map: "ativo_status_idx")
  @@index([usuarioUsername], map: "ativo_usuario_idx")
  @@index([ouCodigo], map: "ativo_ou_idx")
  @@index([numeroSerie], map: "ativo_serie_idx")
  @@map("ativo")
}

model AtivoHistorico {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ativoId String @map("ativo_id") @db.Uuid
  ativo   Ativo  @relation(fields: [ativoId], references: [id], onDelete: Cascade)

  autorUsername String  @map("autor_username")
  campo         String
  valorAnterior String? @map("valor_anterior")
  valorNovo     String? @map("valor_novo")
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@index([ativoId, criadoEm], map: "ativo_historico_idx")
  @@map("ativo_historico")
}

/** Vínculo N:N chamado ↔ ativo (como no GLPI). */
model ChamadoAtivo {
  chamadoId String  @map("chamado_id") @db.Uuid
  ativoId   String  @map("ativo_id") @db.Uuid
  chamado   Chamado @relation(fields: [chamadoId], references: [id], onDelete: Cascade)
  ativo     Ativo   @relation(fields: [ativoId], references: [id], onDelete: Cascade)
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@id([chamadoId, ativoId])
  @@map("chamado_ativo")
}
